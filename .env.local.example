# Supabase project: ledzone-erp (org: SCMS)
NEXT_PUBLIC_SUPABASE_URL=https://eorcwvtoudxtkxqmbqbj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_EaxbRI1VU9N7hTkVSzUh1Q_RvFG165a

# Server-only. Get from Supabase Dashboard > Project Settings > API > service_role key.
# NEVER prefix with NEXT_PUBLIC_ and never send to the browser — it bypasses RLS entirely.
SUPABASE_SERVICE_ROLE_KEY=

# Required in production for the weekly/monthly financial report cron (vercel.json,
# app/api/cron/financial-reports/*) to run at all -- without it those routes refuse every
# request, including Vercel's own. Generate any random string; Vercel Cron sends it back as
# `Authorization: Bearer $CRON_SECRET` automatically once this env var exists on the project.
CRON_SECRET=

# Prisma. Get from Supabase Dashboard > Project Settings > Database > Connection string.
# DATABASE_URL = "Transaction pooler" (port 6543, used at runtime, add ?pgbouncer=true)
# DIRECT_URL   = "Session pooler" or direct connection (port 5432, used for migrations/introspection)
DATABASE_URL="postgresql://postgres.eorcwvtoudxtkxqmbqbj:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.eorcwvtoudxtkxqmbqbj:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

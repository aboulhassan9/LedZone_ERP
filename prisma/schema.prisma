  model      EquipmentModel?     @relation(fields: [modelId], references: [id])

  @@map("warehouse_cycle_count_lines")
}

model WarehouseReservation {
  id                  String    @id @default(uuid()) @db.Uuid
  warehouseLocationId String?   @map("warehouse_location_id") @db.Uuid
  itemId              String?   @map("item_id") @db.Uuid
  reservedForType     String    @map("reserved_for_type")
  reservedBy          String?   @map("reserved_by") @db.Uuid
  reservedAt          DateTime  @default(now()) @map("reserved_at") @db.Timestamptz
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz
  releasedAt          DateTime? @map("released_at") @db.Timestamptz
  referenceNote       String?   @map("reference_note")

  warehouseLocation WarehouseLocation? @relation(fields: [warehouseLocationId], references: [id])
  item              EquipmentItem?     @relation(fields: [itemId], references: [id])

  planItemAssignments EquipmentPlanItemAssignment[]

  @@map("warehouse_reservations")
}

model WarehouseDocument {
  id                String    @id @default(uuid()) @db.Uuid
  relatedEntityType String    @map("related_entity_type")
  relatedEntityId   String    @map("related_entity_id") @db.Uuid
  documentType      String    @map("document_type")
  fileName          String    @map("file_name")
  storagePath       String    @unique @map("storage_path")
  mimeType          String?   @map("mime_type")
  fileSizeBytes     BigInt?   @map("file_size_bytes")
  uploadedBy        String?   @map("uploaded_by") @db.Uuid
  description       String?
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  createdBy         String?   @map("created_by") @db.Uuid
  updatedBy         String?   @map("updated_by") @db.Uuid
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy         String?   @map("deleted_by") @db.Uuid

  @@map("warehouse_documents")
}

// ---- Module 4: Resource Planning & Scheduling Engine ----

model EquipmentPlan {
  id                 String    @id @default(uuid()) @db.Uuid
  name               String
  eventStartAt       DateTime  @map("event_start_at") @db.Timestamptz
  eventEndAt         DateTime  @map("event_end_at") @db.Timestamptz
  customerId         String?   @map("customer_id") @db.Uuid
  eventId            String?   @map("event_id") @db.Uuid
  status             String    @default("draft")
  primaryWarehouseId String?   @map("primary_warehouse_id") @db.Uuid
  notes              String?
  approvedBy         String?   @map("approved_by") @db.Uuid
  approvedAt         DateTime? @map("approved_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  createdBy          String?   @map("created_by") @db.Uuid
  updatedBy          String?   @map("updated_by") @db.Uuid
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy          String?   @map("deleted_by") @db.Uuid

  primaryWarehouse Warehouse? @relation(fields: [primaryWarehouseId], references: [id])
  customer         Customer?  @relation(fields: [customerId], references: [id])
  event            Event?     @relation(fields: [eventId], references: [id])

  items               EquipmentPlanItem[]
  resourceAssignments ResourceAssignment[]
  conflicts           EquipmentConflict[] @relation("PlanConflicts")
  conflictsAsOther    EquipmentConflict[] @relation("ConflictingPlan")
  shortages           EquipmentShortage[]
  versions            EquipmentPlanVersion[]

  @@map("equipment_plans")
}

model EquipmentPlanItem {
  id                String   @id @default(uuid()) @db.Uuid
  planId            String   @map("plan_id") @db.Uuid
  modelId           String   @map("model_id") @db.Uuid
  quantityRequested Decimal  @map("quantity_requested") @db.Decimal(14, 2)
  warehouseId       String?  @map("warehouse_id") @db.Uuid
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz
  createdBy         String?  @map("created_by") @db.Uuid
  updatedBy         String?  @map("updated_by") @db.Uuid

  plan      EquipmentPlan  @relation(fields: [planId], references: [id])
  model     EquipmentModel @relation(fields: [modelId], references: [id])
  warehouse Warehouse?     @relation(fields: [warehouseId], references: [id])

  assignments EquipmentPlanItemAssignment[]
  conflicts   EquipmentConflict[]
  shortages   EquipmentShortage[]

  @@map("equipment_plan_items")
}

model CrewMember {
  id        String    @id @default(uuid()) @db.Uuid
  fullName  String    @map("full_name")
  role      String?
  phone     String?
  email     String?
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy String?   @map("deleted_by") @db.Uuid

  resourceAssignments ResourceAssignment[]

  @@map("crew_members")
}

model Vehicle {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  plateNumber   String?   @map("plate_number")
  vehicleType   String?   @map("vehicle_type")
  capacityNotes String?   @map("capacity_notes")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  createdBy     String?   @map("created_by") @db.Uuid
  updatedBy     String?   @map("updated_by") @db.Uuid
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy     String?   @map("deleted_by") @db.Uuid

  resourceAssignments ResourceAssignment[]

  @@map("vehicles")
}

model ResourceAssignment {
  id               String   @id @default(uuid()) @db.Uuid
  planId           String   @map("plan_id") @db.Uuid
  resourceType     String   @map("resource_type")
  crewMemberId     String?  @map("crew_member_id") @db.Uuid
  vehicleId        String?  @map("vehicle_id") @db.Uuid
  roleOrPurpose    String?  @map("role_or_purpose")
  scheduledStartAt DateTime @map("scheduled_start_at") @db.Timestamptz
  scheduledEndAt   DateTime @map("scheduled_end_at") @db.Timestamptz
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz
  createdBy        String?  @map("created_by") @db.Uuid
  updatedBy        String?  @map("updated_by") @db.Uuid

  plan       EquipmentPlan @relation(fields: [planId], references: [id])
  crewMember CrewMember?   @relation(fields: [crewMemberId], references: [id])
  vehicle    Vehicle?      @relation(fields: [vehicleId], references: [id])

  @@map("resource_assignments")
}

model EquipmentPlanItemAssignment {
  id                     String   @id @default(uuid()) @db.Uuid
  planItemId             String   @map("plan_item_id") @db.Uuid
  itemId                 String   @map("item_id") @db.Uuid
  warehouseReservationId String?  @map("warehouse_reservation_id") @db.Uuid
  assignedAt             DateTime @default(now()) @map("assigned_at") @db.Timestamptz
  assignedBy             String?  @map("assigned_by") @db.Uuid

  planItem             EquipmentPlanItem     @relation(fields: [planItemId], references: [id])
  item                 EquipmentItem         @relation(fields: [itemId], references: [id])
  warehouseReservation WarehouseReservation? @relation(fields: [warehouseReservationId], references: [id])

  @@map("equipment_plan_item_assignments")
}

model EquipmentConflict {
  id                String    @id @default(uuid()) @db.Uuid
  planId            String    @map("plan_id") @db.Uuid
  planItemId        String?   @map("plan_item_id") @db.Uuid
  conflictType      String    @map("conflict_type")
  severity          String
  conflictingPlanId String?   @map("conflicting_plan_id") @db.Uuid
  description       String
  detectedAt        DateTime  @default(now()) @map("detected_at") @db.Timestamptz
  resolvedAt        DateTime? @map("resolved_at") @db.Timestamptz
  resolvedBy        String?   @map("resolved_by") @db.Uuid

  plan            EquipmentPlan      @relation("PlanConflicts", fields: [planId], references: [id])
  planItem        EquipmentPlanItem? @relation(fields: [planItemId], references: [id])
  conflictingPlan EquipmentPlan?     @relation("ConflictingPlan", fields: [conflictingPlanId], references: [id])

  @@map("equipment_conflicts")
}

model EquipmentShortage {
  id            String    @id @default(uuid()) @db.Uuid
  planId        String    @map("plan_id") @db.Uuid
  planItemId    String    @map("plan_item_id") @db.Uuid
  quantityShort Decimal   @map("quantity_short") @db.Decimal(14, 2)
  detectedAt    DateTime  @default(now()) @map("detected_at") @db.Timestamptz
  resolvedAt    DateTime? @map("resolved_at") @db.Timestamptz

  plan     EquipmentPlan     @relation(fields: [planId], references: [id])
  planItem EquipmentPlanItem @relation(fields: [planItemId], references: [id])

  @@map("equipment_shortages")
}

model EquipmentPlanVersion {
  id              String   @id @default(uuid()) @db.Uuid
  planId          String   @map("plan_id") @db.Uuid
  versionNumber   Int      @map("version_number")
  statusAtVersion String   @map("status_at_version")
  snapshotJson    Json     @default("{}") @map("snapshot_json")
  changeSummary   String?  @map("change_summary")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy       String?  @map("created_by") @db.Uuid

  plan EquipmentPlan @relation(fields: [planId], references: [id])

  @@unique([planId, versionNumber])
  @@map("equipment_plan_versions")
}

// ---- Module 5: CRM ----

model Customer {
  id              String    @id @default(uuid()) @db.Uuid
  customerType    String    @default("company") @map("customer_type")
  lifecycleStage  String    @default("lead") @map("lifecycle_stage")
  companyName     String?   @map("company_name")
  fullName        String?   @map("full_name")
  email           String?
  phone           String?
  billingAddress  String?   @map("billing_address")
  taxId           String?   @map("tax_id")
  source          String?
  assignedTo      String?   @map("assigned_to") @db.Uuid
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  createdBy       String?   @map("created_by") @db.Uuid
  updatedBy       String?   @map("updated_by") @db.Uuid
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy       String?   @map("deleted_by") @db.Uuid

  contacts         CustomerContact[]
  quotes           Quote[]
  equipmentPlans   EquipmentPlan[]
  events           Event[]
  rentalAgreements RentalAgreement[]

  @@map("customers")
}

model CustomerContact {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  fullName   String   @map("full_name")
  role       String?
  email      String?
  phone      String?
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz
  createdBy  String?  @map("created_by") @db.Uuid
  updatedBy  String?  @map("updated_by") @db.Uuid

  customer Customer @relation(fields: [customerId], references: [id])

  @@map("customer_contacts")
}

model Quote {
  id           String    @id @default(uuid()) @db.Uuid
  quoteNumber  String    @unique @map("quote_number")
  customerId   String    @map("customer_id") @db.Uuid
  status       String    @default("draft")
  validUntil   DateTime? @map("valid_until") @db.Date
  currencyCode String    @map("currency_code")
  eventId      String?   @map("event_id") @db.Uuid
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  createdBy    String?   @map("created_by") @db.Uuid
  updatedBy    String?   @map("updated_by") @db.Uuid
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy    String?   @map("deleted_by") @db.Uuid

  customer Customer @relation(fields: [customerId], references: [id])
  currency Currency @relation(fields: [currencyCode], references: [code])
  event    Event?   @relation(fields: [eventId], references: [id])

  lineItems        QuoteLineItem[]
  rentalAgreements RentalAgreement[]

  @@map("quotes")
}

model QuoteLineItem {
  id        String   @id @default(uuid()) @db.Uuid
  quoteId   String   @map("quote_id") @db.Uuid
  modelId   String   @map("model_id") @db.Uuid
  quantity  Decimal  @db.Decimal(14, 2)
  unitPrice Decimal  @map("unit_price") @db.Decimal(14, 2)
  notes     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  quote Quote          @relation(fields: [quoteId], references: [id])
  model EquipmentModel @relation(fields: [modelId], references: [id])

  @@map("quote_line_items")
}

// ---- Module 6: Events ----

model Event {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  customerId   String?   @map("customer_id") @db.Uuid
  venue        String?
  eventStartAt DateTime  @map("event_start_at") @db.Timestamptz
  eventEndAt   DateTime  @map("event_end_at") @db.Timestamptz
  status       String    @default("planning")
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  createdBy    String?   @map("created_by") @db.Uuid
  updatedBy    String?   @map("updated_by") @db.Uuid
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy    String?   @map("deleted_by") @db.Uuid

  customer Customer? @relation(fields: [customerId], references: [id])

  checklistItems   EventChecklistItem[]
  timelineItems    EventTimelineItem[]
  equipmentPlans   EquipmentPlan[]
  quotes           Quote[]
  rentalAgreements RentalAgreement[]

  @@map("events")
}

model EventChecklistItem {
  id         String    @id @default(uuid()) @db.Uuid
  eventId    String    @map("event_id") @db.Uuid
  title      String
  isDone     Boolean   @default(false) @map("is_done")
  dueAt      DateTime? @map("due_at") @db.Timestamptz
  assignedTo String?   @map("assigned_to") @db.Uuid
  notes      String?
  sequence   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  createdBy  String?   @map("created_by") @db.Uuid
  updatedBy  String?   @map("updated_by") @db.Uuid

  event Event @relation(fields: [eventId], references: [id])

  @@map("event_checklist_items")
}

model EventTimelineItem {
  id               String   @id @default(uuid()) @db.Uuid
  eventId          String   @map("event_id") @db.Uuid
  title            String
  scheduledAt      DateTime @map("scheduled_at") @db.Timestamptz
  durationMinutes  Int?     @map("duration_minutes")
  notes            String?
  sequence         Int      @default(0)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz
  createdBy        String?  @map("created_by") @db.Uuid
  updatedBy        String?  @map("updated_by") @db.Uuid

  event Event @relation(fields: [eventId], references: [id])

  @@map("event_timeline_items")
}

// ---- Module 7: Rental ----

model RentalAgreement {
  id              String    @id @default(uuid()) @db.Uuid
  agreementNumber String    @unique @map("agreement_number")
  customerId      String    @map("customer_id") @db.Uuid
  eventId         String?   @map("event_id") @db.Uuid
  quoteId         String?   @map("quote_id") @db.Uuid
  status          String    @default("draft")
  currencyCode    String    @map("currency_code")
  rentalStartAt   DateTime  @map("rental_start_at") @db.Timestamptz
  rentalEndAt     DateTime  @map("rental_end_at") @db.Timestamptz
  depositAmount   Decimal   @default(0) @map("deposit_amount") @db.Decimal(14, 2)
  depositStatus   String    @default("held") @map("deposit_status")
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  createdBy       String?   @map("created_by") @db.Uuid
  updatedBy       String?   @map("updated_by") @db.Uuid
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy       String?   @map("deleted_by") @db.Uuid

  customer Customer @relation(fields: [customerId], references: [id])
  event    Event?   @relation(fields: [eventId], references: [id])
  quote    Quote?   @relation(fields: [quoteId], references: [id])
  currency Currency @relation(fields: [currencyCode], references: [code])

  lineItems RentalAgreementLineItem[]

  @@map("rental_agreements")
}

model RentalAgreementLineItem {
  id          String   @id @default(uuid()) @db.Uuid
  agreementId String   @map("agreement_id") @db.Uuid
  modelId     String   @map("model_id") @db.Uuid
  quantity    Decimal  @db.Decimal(14, 2)
  dailyRate   Decimal  @map("daily_rate") @db.Decimal(14, 2)
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  agreement RentalAgreement @relation(fields: [agreementId], references: [id])
  model     EquipmentModel  @relation(fields: [modelId], references: [id])

  @@map("rental_agreement_line_items")
}

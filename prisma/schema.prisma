model ConsumableStockLevel {
  id                String   @id @default(uuid()) @db.Uuid
  modelId           String   @map("model_id") @db.Uuid
  storageLocationId String   @map("storage_location_id") @db.Uuid
  quantityOnHand    Decimal  @default(0) @map("quantity_on_hand") @db.Decimal(14, 2)
  unitOfMeasure     String   @default("pcs") @map("unit_of_measure")

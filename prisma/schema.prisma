// This schema mirrors supabase/migrations/0001-0009 exactly. The SQL migrations are the
// source of truth for the database (tables, RLS, triggers, functions) — this file gives
// the app a typed Prisma Client on top of that same schema. After any migration change,
// re-sync with: npx prisma db pull && npx prisma generate.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id         String    @id @db.Uuid
  fullName   String    @map("full_name")
  phone      String?
  avatarUrl  String?   @map("avatar_url")
  locationId String?   @map("location_id") @db.Uuid
  status     String    @default("active")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  createdBy  String?   @map("created_by") @db.Uuid
  updatedBy  String?   @map("updated_by") @db.Uuid
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy  String?   @map("deleted_by") @db.Uuid

  location Location? @relation(fields: [locationId], references: [id])

  userRoles     UserRole[]
  auditLogs     AuditLog[]
  notifications Notification[]

  @@map("profiles")
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  description String?
  isSystem    Boolean   @default(false) @map("is_system")
  status      String    @default("active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  createdBy   String?   @map("created_by") @db.Uuid
  updatedBy   String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy   String?   @map("deleted_by") @db.Uuid

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy String?  @map("created_by") @db.Uuid

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy    String?  @map("created_by") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Location {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  address   String?
  city      String    @default("Kinshasa")
  country   String    @default("Democratic Republic of Congo")
  phone     String?
  status    String    @default("active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy String?   @map("deleted_by") @db.Uuid

  profiles         Profile[]
  storageLocations StorageLocation[]
  warehouses       Warehouse[]

  @@map("locations")
}

model CompanyProfile {
  id              String   @id @default(uuid()) @db.Uuid
  singleton       Boolean  @default(true)
  legalName       String   @default("LED Zone") @map("legal_name")
  displayName     String   @default("LED Zone") @map("display_name")
  address         String?
  city            String   @default("Kinshasa")
  country         String   @default("Democratic Republic of Congo")
  phone           String?
  email           String?
  logoUrl         String?  @map("logo_url")
  defaultCurrency String   @default("USD") @map("default_currency")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy       String?  @map("updated_by") @db.Uuid

  currency Currency @relation(fields: [defaultCurrency], references: [code])

  @@map("company_profile")
}

model Currency {
  code          String   @id
  name          String
  symbol        String
  decimalPlaces Int      @default(2) @map("decimal_places") @db.SmallInt
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz
  updatedBy     String?  @map("updated_by") @db.Uuid

  companyProfiles CompanyProfile[]
  baseRates       ExchangeRate[]   @relation("BaseCurrency")
  quoteRates      ExchangeRate[]   @relation("QuoteCurrency")

  suppliers                    Supplier[]
  purchases                    EquipmentPurchase[]
  depreciationPoliciesPurchase EquipmentDepreciationPolicy[] @relation("DepreciationPurchaseCurrency")
  depreciationPoliciesSalvage  EquipmentDepreciationPolicy[] @relation("DepreciationSalvageCurrency")
  itemValuations               EquipmentItemValuation[]
  maintenanceRecords           EquipmentMaintenanceRecord[]
  damageReports                EquipmentDamageReport[]
  quotes                       Quote[]
  rentalAgreements             RentalAgreement[]

  @@map("currencies")
}

model ExchangeRate {
  id            String    @id @default(uuid()) @db.Uuid
  baseCurrency  String    @map("base_currency")
  quoteCurrency String    @map("quote_currency")
  rate          Decimal   @db.Decimal(18, 6)
  rateDate      DateTime  @default(now()) @map("rate_date") @db.Date
  source        String    @default("manual")
  note          String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy     String?   @map("created_by") @db.Uuid
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy     String?   @map("deleted_by") @db.Uuid

  base  Currency @relation("BaseCurrency", fields: [baseCurrency], references: [code])
  quote Currency @relation("QuoteCurrency", fields: [quoteCurrency], references: [code])

  purchases EquipmentPurchase[]

  @@map("exchange_rates")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  changes    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor Profile? @relation(fields: [actorId], references: [id])

  @@map("audit_logs")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  title     String
  body      String?
  type      String    @default("info")
  linkUrl   String?   @map("link_url")
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Module 2: Inventory Foundation (supabase/migrations/0012-0025)
// ---------------------------------------------------------------------------

model EquipmentCategory {
  id          String    @id @default(uuid()) @db.Uuid
  parentId    String?   @map("parent_id") @db.Uuid
  name        String
  description String?
  icon        String?
  status      String    @default("active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  createdBy   String?   @map("created_by") @db.Uuid
  updatedBy   String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy   String?   @map("deleted_by") @db.Uuid

  parent   EquipmentCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children EquipmentCategory[] @relation("CategoryHierarchy")

  models            EquipmentModel[]
  specificationDefs EquipmentSpecificationDefinition[]
  assetTagFormats   EquipmentAssetTagFormat[]

  @@map("equipment_categories")
}

model Manufacturer {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  country      String?
  website      String?
  supportEmail String?   @map("support_email")
  supportPhone String?   @map("support_phone")
  status       String    @default("active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  createdBy    String?   @map("created_by") @db.Uuid
  updatedBy    String?   @map("updated_by") @db.Uuid
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy    String?   @map("deleted_by") @db.Uuid

  brands Brand[]
  models EquipmentModel[]

  @@map("manufacturers")
}

model Brand {
  id             String    @id @default(uuid()) @db.Uuid
  manufacturerId String?   @map("manufacturer_id") @db.Uuid
  name           String
  website        String?
  status         String    @default("active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy      String?   @map("deleted_by") @db.Uuid

  manufacturer Manufacturer?    @relation(fields: [manufacturerId], references: [id])
  models       EquipmentModel[]

  @@map("brands")
}

model Supplier {
  id                String    @id @default(uuid()) @db.Uuid
  name              String
  contactName       String?   @map("contact_name")
  email             String?
  phone             String?
  address           String?
  country           String?
  preferredCurrency String?   @map("preferred_currency")
  status            String    @default("active")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  createdBy         String?   @map("created_by") @db.Uuid
  updatedBy         String?   @map("updated_by") @db.Uuid
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy         String?   @map("deleted_by") @db.Uuid

  currency  Currency?           @relation(fields: [preferredCurrency], references: [code])
  purchases EquipmentPurchase[]

  @@map("suppliers")
}

model StorageLocation {
  id                  String    @id @default(uuid()) @db.Uuid
  locationId          String    @map("location_id") @db.Uuid
  name                String
  code                String?
  warehouseLocationId String?   @map("warehouse_location_id") @db.Uuid
  status              String    @default("active")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  createdBy           String?   @map("created_by") @db.Uuid
  updatedBy           String?   @map("updated_by") @db.Uuid
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy           String?   @map("deleted_by") @db.Uuid

  location          Location           @relation(fields: [locationId], references: [id])
  warehouseLocation WarehouseLocation? @relation(fields: [warehouseLocationId], references: [id])

  items                 EquipmentItem[]
  lostReports           EquipmentLostReport[]
  scans                 EquipmentItemScan[]
  movementsFrom         EquipmentItemMovement[]   @relation("MovementFromLocation")
  movementsTo           EquipmentItemMovement[]   @relation("MovementToLocation")
  consumableStockLevels ConsumableStockLevel[]
  consumableStockMoves  ConsumableStockMovement[]

  @@map("storage_locations")
}

model EquipmentAssetTagFormat {
  id             String   @id @default(uuid()) @db.Uuid
  categoryId     String?  @map("category_id") @db.Uuid
  prefix         String
  separator      String   @default("-")
  sequenceLength Int      @default(6) @map("sequence_length") @db.SmallInt
  nextSequence   BigInt   @default(1) @map("next_sequence")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz
  createdBy      String?  @map("created_by") @db.Uuid
  updatedBy      String?  @map("updated_by") @db.Uuid

  category EquipmentCategory? @relation(fields: [categoryId], references: [id])

  @@map("equipment_asset_tag_formats")
}

model EquipmentModel {
  id                     String    @id @default(uuid()) @db.Uuid
  categoryId             String    @map("category_id") @db.Uuid
  manufacturerId         String    @map("manufacturer_id") @db.Uuid
  brandId                String?   @map("brand_id") @db.Uuid
  modelName              String    @map("model_name")
  modelNumber            String?   @map("model_number")
  description            String?
  trackingType           String    @default("individual") @map("tracking_type")
  specifications         Json      @default("{}")
  defaultWarrantyMonths  Int?      @map("default_warranty_months")
  expectedLifespanMonths Int?      @map("expected_lifespan_months")
  imageUrl               String?   @map("image_url")
  status                 String    @default("active")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  createdBy              String?   @map("created_by") @db.Uuid
  updatedBy              String?   @map("updated_by") @db.Uuid
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy              String?   @map("deleted_by") @db.Uuid

  category     EquipmentCategory @relation(fields: [categoryId], references: [id])
  manufacturer Manufacturer      @relation(fields: [manufacturerId], references: [id])
  brand        Brand?            @relation(fields: [brandId], references: [id])

  items                 EquipmentItem[]
  consumableStockLevels ConsumableStockLevel[]
  consumableStockMoves  ConsumableStockMovement[]

  warehouseTransferLines   WarehouseTransferLine[]
  warehouseReceivingLines  WarehouseReceivingLine[]
  warehouseDispatchLines   WarehouseDispatchLine[]
  warehousePickListLines   WarehousePickListLine[]
  warehouseCycleCountLines WarehouseCycleCountLine[]

  equipmentPlanItems       EquipmentPlanItem[]
  quoteLineItems           QuoteLineItem[]
  rentalAgreementLineItems RentalAgreementLineItem[]

  @@map("equipment_models")
}

model EquipmentSpecificationDefinition {
  id           String    @id @default(uuid()) @db.Uuid
  categoryId   String    @map("category_id") @db.Uuid
  specKey      String    @map("spec_key")
  label        String
  dataType     String    @default("text") @map("data_type")
  unit         String?
  displayOrder Int       @default(0) @map("display_order")
  isRequired   Boolean   @default(false) @map("is_required")
  status       String    @default("active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  createdBy    String?   @map("created_by") @db.Uuid
  updatedBy    String?   @map("updated_by") @db.Uuid
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy    String?   @map("deleted_by") @db.Uuid

  category EquipmentCategory @relation(fields: [categoryId], references: [id])

  @@unique([categoryId, specKey])
  @@map("equipment_specification_definitions")
}

model EquipmentItem {
  id                       String    @id @default(uuid()) @db.Uuid
  modelId                  String    @map("model_id") @db.Uuid
  assetTag                 String    @unique @map("asset_tag")
  serialNumber             String?   @map("serial_number")
  purchaseId               String?   @map("purchase_id") @db.Uuid
  currentStatus            String    @default("available") @map("current_status")
  currentCondition         String    @default("new") @map("current_condition")
  currentStorageLocationId String?   @map("current_storage_location_id") @db.Uuid
  notes                    String?
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  createdBy                String?   @map("created_by") @db.Uuid
  updatedBy                String?   @map("updated_by") @db.Uuid
  deletedAt                DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy                String?   @map("deleted_by") @db.Uuid

  model                  EquipmentModel     @relation(fields: [modelId], references: [id])
  purchase               EquipmentPurchase? @relation(fields: [purchaseId], references: [id])
  currentStorageLocation StorageLocation?   @relation(fields: [currentStorageLocationId], references: [id])

  warranties           EquipmentItemWarranty[]
  valuations           EquipmentItemValuation[]
  depreciationPolicy   EquipmentDepreciationPolicy?
  maintenanceSchedules EquipmentMaintenanceSchedule[]
  maintenanceRecords   EquipmentMaintenanceRecord[]
  damageReports        EquipmentDamageReport[]
  lostReports          EquipmentLostReport[]
  codes                EquipmentItemCode[]
  scans                EquipmentItemScan[]
  movements            EquipmentItemMovement[]
  attachments          EquipmentItemAttachment[]

  warehouseTransferLines   WarehouseTransferLine[]
  warehouseReceivingLines  WarehouseReceivingLine[]
  warehouseDispatchLines   WarehouseDispatchLine[]
  warehousePickListLines   WarehousePickListLine[]
  warehouseCycleCountLines WarehouseCycleCountLine[]
  warehouseReservations    WarehouseReservation[]

  planItemAssignments EquipmentPlanItemAssignment[]

  @@map("equipment_items")
}

model EquipmentPurchase {
  id             String    @id @default(uuid()) @db.Uuid
  supplierId     String    @map("supplier_id") @db.Uuid
  purchaseDate   DateTime  @default(now()) @map("purchase_date") @db.Date
  invoiceNumber  String?   @map("invoice_number")
  currencyCode   String    @map("currency_code")
  exchangeRateId String?   @map("exchange_rate_id") @db.Uuid
  subtotalAmount Decimal?  @map("subtotal_amount") @db.Decimal(14, 2)
  taxAmount      Decimal?  @map("tax_amount") @db.Decimal(14, 2)
  totalAmount    Decimal   @map("total_amount") @db.Decimal(14, 2)
  status         String    @default("ordered")
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy      String?   @map("deleted_by") @db.Uuid

  supplier     Supplier      @relation(fields: [supplierId], references: [id])
  currency     Currency      @relation(fields: [currencyCode], references: [code])
  exchangeRate ExchangeRate? @relation(fields: [exchangeRateId], references: [id])

  items      EquipmentItem[]
  warranties EquipmentItemWarranty[]

  warehouseReceivingRecords WarehouseReceivingRecord[]

  @@map("equipment_purchases")
}

model EquipmentItemWarranty {
  id           String    @id @default(uuid()) @db.Uuid
  itemId       String    @map("item_id") @db.Uuid
  purchaseId   String?   @map("purchase_id") @db.Uuid
  providerType String    @map("provider_type")
  providerName String?   @map("provider_name")
  warrantyType String?   @map("warranty_type")
  startDate    DateTime  @map("start_date") @db.Date
  endDate      DateTime  @map("end_date") @db.Date
  terms        String?
  claimContact String?   @map("claim_contact")
  status       String    @default("active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  createdBy    String?   @map("created_by") @db.Uuid
  updatedBy    String?   @map("updated_by") @db.Uuid
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy    String?   @map("deleted_by") @db.Uuid

  item     EquipmentItem      @relation(fields: [itemId], references: [id])
  purchase EquipmentPurchase? @relation(fields: [purchaseId], references: [id])

  @@map("equipment_item_warranties")
}

model EquipmentDepreciationPolicy {
  id               String    @id @default(uuid()) @db.Uuid
  itemId           String    @unique @map("item_id") @db.Uuid
  purchaseCost     Decimal   @map("purchase_cost") @db.Decimal(14, 2)
  purchaseCurrency String    @map("purchase_currency")
  salvageValue     Decimal   @default(0) @map("salvage_value") @db.Decimal(14, 2)
  salvageCurrency  String    @map("salvage_currency")
  usefulLifeMonths Int       @map("useful_life_months")
  method           String    @default("straight_line")
  startDate        DateTime  @default(now()) @map("start_date") @db.Date
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  createdBy        String?   @map("created_by") @db.Uuid
  updatedBy        String?   @map("updated_by") @db.Uuid
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy        String?   @map("deleted_by") @db.Uuid

  item                EquipmentItem @relation(fields: [itemId], references: [id])
  purchaseCurrencyRef Currency      @relation("DepreciationPurchaseCurrency", fields: [purchaseCurrency], references: [code])
  salvageCurrencyRef  Currency      @relation("DepreciationSalvageCurrency", fields: [salvageCurrency], references: [code])

  @@map("equipment_depreciation_policies")
}

model EquipmentItemValuation {
  id           String   @id @default(uuid()) @db.Uuid
  itemId       String   @map("item_id") @db.Uuid
  entryDate    DateTime @default(now()) @map("entry_date") @db.Date
  entryType    String   @map("entry_type")
  amount       Decimal  @db.Decimal(14, 2)
  currencyCode String   @map("currency_code")
  note         String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy    String?  @map("created_by") @db.Uuid

  item     EquipmentItem @relation(fields: [itemId], references: [id])
  currency Currency      @relation(fields: [currencyCode], references: [code])

  @@map("equipment_item_valuations")
}

model EquipmentMaintenanceSchedule {
  id                String    @id @default(uuid()) @db.Uuid
  itemId            String    @map("item_id") @db.Uuid
  maintenanceType   String    @map("maintenance_type")
  intervalDays      Int       @map("interval_days")
  lastPerformedDate DateTime? @map("last_performed_date") @db.Date
  nextDueDate       DateTime? @map("next_due_date") @db.Date
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  createdBy         String?   @map("created_by") @db.Uuid
  updatedBy         String?   @map("updated_by") @db.Uuid
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy         String?   @map("deleted_by") @db.Uuid

  item    EquipmentItem                @relation(fields: [itemId], references: [id])
  records EquipmentMaintenanceRecord[]

  @@map("equipment_maintenance_schedules")
}

model EquipmentMaintenanceRecord {
  id                  String    @id @default(uuid()) @db.Uuid
  itemId              String    @map("item_id") @db.Uuid
  scheduleId          String?   @map("schedule_id") @db.Uuid
  damageReportId      String?   @map("damage_report_id") @db.Uuid
  performedDate       DateTime  @default(now()) @map("performed_date") @db.Date

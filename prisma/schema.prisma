model EquipmentItemScan {
  id             String   @id @default(uuid()) @db.Uuid
  itemCodeId     String   @map("item_code_id") @db.Uuid
  itemId         String   @map("item_id") @db.Uuid
  scannedBy      String?  @map("scanned_by") @db.Uuid
  scannedAt      DateTime @default(now()) @map("scanned_at") @db.Timestamptz
  scanContext    String   @default("lookup") @map("scan_context")
  locationAtScan String?  @map("location_at_scan") @db.Uuid
  deviceInfo     Json?    @map("device_info")
  note           String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  itemCode          EquipmentItemCode @relation(fields: [itemCodeId], references: [id])
  item              EquipmentItem     @relation(fields: [itemId], references: [id])
  locationAtScanRef StorageLocation?  @relation(fields: [locationAtScan], references: [id])

  @@map("equipment_item_scans")
}

model EquipmentItemMovement {
  id                    String   @id @default(uuid()) @db.Uuid

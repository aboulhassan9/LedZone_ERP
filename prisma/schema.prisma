model EquipmentItemCode {
  id           String    @id @default(uuid()) @db.Uuid
  itemId       String    @map("item_id") @db.Uuid
  codeType     String    @map("code_type")
  codeValue    String    @unique @map("code_value")
  imageUrl     String?   @map("image_url")
  isActive     Boolean   @default(true) @map("is_active")
  generatedAt  DateTime  @default(now()) @map("generated_at") @db.Timestamptz
  supersededAt DateTime? @map("superseded_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  createdBy    String?   @map("created_by") @db.Uuid
  updatedBy    String?   @map("updated_by") @db.Uuid
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy    String?   @map("deleted_by") @db.Uuid

